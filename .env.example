# Template for .env — copy it, fill in your own values, never commit the result.
#   cp .env.example .env && chmod 600 .env
#
# The code reads these as environment variables. A real environment variable always
# wins over .env, so on a server you can set them via systemd and skip the file.

# --- secrets (leave empty here; fill them in .env) ---

# SharedOS Cloud key. Authorizes decision events to the audit sink.
SHAREDOS_KEY=

# Reviewer model credentials (any OpenAI-compatible endpoint).
OPENROUTER_API_KEY=

# Bearer token for the reviewer-side endpoints (/v1/reviews/pending, POST findings).
# Leave empty and one is generated at spe_state/reviewer_token on first start.
SPE_REVIEWER_TOKEN=

# --- settings (safe defaults; override only if you need to) ---

REVIEW_MODEL=poolside/laguna-s-2.1:free
# Tried in order when the primary stalls or rate-limits. Free first, paid last.
REVIEW_FALLBACK_MODELS=nex-agi/nex-n2.5-mini:free,inclusionai/ling-3.0-flash
REVIEW_API_URL=https://openrouter.ai/api/v1/chat/completions

# How much upstream work runs at once, and how much of an artifact is sent.
# Concurrency is capped because the provider stalls under load rather than erroring.
REVIEW_MAX_INFLIGHT=4
REVIEW_MAX_ARTIFACT_CHARS=12000
# A fallback needs a timeout that fits it, not the fast model's.
REVIEW_FAST_TIMEOUT=60
REVIEW_FALLBACK_TIMEOUT=200
SHAREDOS_AUDIT_URL=https://www.sharedos.ai/v1/audit/events
SPE_KERNEL_URL=http://127.0.0.1:8450/authorize
SPE_BIND=127.0.0.1
SPE_REVIEWERS=3
